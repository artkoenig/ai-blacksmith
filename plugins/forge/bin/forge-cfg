#!/usr/bin/env bash
# Reads .forge/config.json. Usage: forge-cfg get <dotted.path> [default]
set -uo pipefail

# Resolve the root from where the caller stands, not from the session.
#
# A run happens inside a git worktree, so `cd <worktree> && forge-test` has to
# find that worktree's config and run the suite there. Walking up from $PWD does
# that: .forge/config.json is a tracked file, so a worktree checkout carries its
# own copy. CLAUDE_PROJECT_DIR is the last resort precisely because it points at
# the main checkout even when the caller is somewhere else.
forge_root() {
  local dir
  dir="$(pwd -P)"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.forge/config.json" ]; then
      printf '%s\n' "$dir"
      return
    fi
    dir="$(dirname "$dir")"
  done
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    git rev-parse --show-toplevel
  elif [ -n "${CLAUDE_PROJECT_DIR:-}" ] && [ -d "$CLAUDE_PROJECT_DIR" ]; then
    printf '%s\n' "$CLAUDE_PROJECT_DIR"
  else
    pwd -P
  fi
}

ROOT="$(forge_root)"
CFG="$ROOT/.forge/config.json"

case "${1:-}" in
  root) printf '%s\n' "$ROOT" ;;
  path) printf '%s\n' "$CFG" ;;
  exists) [ -f "$CFG" ] && printf 'yes\n' || printf 'no\n' ;;
  get)
    key="${2:-}"
    fallback="${3:-}"
    [ -f "$CFG" ] || { printf '%s\n' "$fallback"; exit 0; }
    node -e '
      const fs = require("fs");
      let cfg;
      try { cfg = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); }
      catch { process.stdout.write(process.argv[3] || ""); process.exit(0); }
      const value = process.argv[2].split(".").reduce((o, k) => (o == null ? o : o[k]), cfg);
      if (value == null || value === "") { process.stdout.write(process.argv[3] || ""); }
      else if (typeof value === "object") { process.stdout.write(JSON.stringify(value)); }
      else { process.stdout.write(String(value)); }
    ' "$CFG" "$key" "$fallback"
    printf '\n'
    ;;
  *) printf 'usage: forge-cfg root|path|exists|get <dotted.path> [default]\n' >&2; exit 2 ;;
esac
