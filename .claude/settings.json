{
  "autoMemoryEnabled": true,
  "outputStyle": "Forge Terse",
  "env": { "CLAUDE_CODE_REMOTE_MEMORY_DIR": "~/.claude/remote-memory" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/plugins/forge/scripts/guard-bash.js"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/plugins/forge/scripts/guard-checkout.js"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/plugins/forge/scripts/compact-output.js"], "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/plugins/forge/scripts/subagent-start.js"], "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/plugins/forge/scripts/subagent-metrics.js"], "timeout": 10 }
        ]
      }
    ]
  }
}
